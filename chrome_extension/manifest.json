{
  "manifest_version": 3,
  "name": "Soccer Collector",
  "version": "0.3.0",
  "description": "Connect a chosen Sofascore tab to your local soccerAnalysis collector.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["https://www.sofascore.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Soccer Collector"}
}
