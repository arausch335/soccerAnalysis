{
  "manifest_version": 3,
  "name": "Soccer Collector",
  "version": "0.7.1",
  "description": "API fallback collection from Sofascore, WhoScored and FotMob in one chosen Chrome tab.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.sofascore.com/*",
    "https://www.whoscored.com/*",
    "https://www.fotmob.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Soccer Collector"
  }
}
